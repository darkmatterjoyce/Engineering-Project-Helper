# Copy to .env and fill in. Nothing here is required for the offline demo (EPH_MOCK=1).
# ---- LLM: pick ONE provider (or leave them all empty and keep EPH_MOCK=1 for the offline demo)
# Anthropic (best quality):
ANTHROPIC_API_KEY=
# Google Gemini, FREE tier, no card: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, FREE tier, no card: https://console.groq.com/keys
GROQ_API_KEY=
# Any other OpenAI-compatible server (Databricks serving endpoints, OpenRouter, OpenAI...):
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Optional: force a provider (anthropic | gemini | groq | openai). Default: the first one with a key, in that order.
EPH_LLM_PROVIDER=
# Optional model overrides. Defaults: anthropic sonnet/opus, gemini 3.8-flash/3.6-flash, groq gpt-oss-120b/llama-3.3-70b
EPH_MODEL=
EPH_REVIEW_MODEL=
# Free tiers: seconds between calls (default gemini 4, groq 2.5) and max_tokens clamp (default groq 8000)
EPH_LLM_MIN_INTERVAL=
EPH_MAX_TOKENS_CAP=

# Bar Raiser (independent reviewer). A different model from the builder = more independent review.
EPH_BAR_RAISER=1
EPH_REVIEW_ROUNDS=2

# ---- Database: pick ONE. MongoDB wins if MONGODB_URI is set; otherwise Databricks if the three
# DATABRICKS_* values are set; otherwise an in-memory DB (lost on restart).
# Databricks (Free Edition works): SQL Warehouses -> your warehouse -> Connection details
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
# Settings -> Developer -> Access tokens -> Generate new token
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=eph
# MongoDB Atlas
# e.g. mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=engineering_project_helper

# Agent memory (precedents). Voyage AI embeddings (VoyageAI by MongoDB) are optional:
# without a key an offline embedding is used. Keys starting al- (Atlas) and pa- (Voyage) both work.
EPH_PRECEDENTS=1
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_DIMS=1024
EPH_PRECEDENT_K=3
EPH_PRECEDENT_MIN_SCORE=

# Live web search for part verification: Linkup first, Tavily as fallback
LINKUP_API_KEY=
LINKUP_DEPTH=standard
TAVILY_API_KEY=

# Firmware compile (scripts/setup_arduino.sh installs these)
ARDUINO_CLI=arduino-cli
EPH_FQBN=esp32:esp32:esp32
EPH_ARDUINO_EXTRA_ARGS=
EPH_MAX_FIX_ATTEMPTS=3

# 1 = canned LLM + search responses: NO API calls, no spend (default). Set 0 only for real runs.
EPH_MOCK=1
